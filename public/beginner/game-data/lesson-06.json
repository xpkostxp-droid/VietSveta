  "theory": [
    {
      "kind": "pattern",
      "heading": "Повторение: вопрос Có ... không?",
      "formula": "Кто + có + действие/состояние + không?",
      "formulaNote": "Вопрос с ответом «да» или «нет»; có здесь не переводится как «иметь». Если спрашиваем о профессии или о том, кем является человек — конструкция «có phải là ... không?» ниже.",
      "examples": [
        {
          "vi": "Anh có khỏe không?",
          "ru": "Как твоё здоровье? / Ты здоров?"
        },
        {
          "vi": "Em có uống cà phê không?",
          "ru": "Ты пьёшь кофе?"
        }
      ]
    },
    {
      "kind": "pattern",
      "heading": "Утверждение + phải không?",
      "formula": "Кто + là + профессия/роль + phải không?",
      "formulaNote": "phải không? — «верно? / не так ли?»: говорящий высказывает предположение и просит подтвердить. Anh перед именем — обращение к мужчине; при обращении напрямую переводится «вы».",
      "examples": [
        {
          "vi": "Anh Artur là bác sĩ, phải không?",
          "ru": "Артур — врач, верно? (обращаясь к нему: «Вы врач, верно?»)"
        }
      ]
    },
    {
      "kind": "pattern",
      "heading": "Вопрос Có phải là ... không?",
      "formula": "Кто + có phải là + профессия/роль + không?",
      "formulaNote": "«Является ли этот человек ...?» Здесь phải là — не «должно быть», а проверка, верно ли, что человек кем-то является (у phải есть и значение «должен», но это другая конструкция).",
      "examples": [
        {
          "vi": "Anh Artur có phải là bác sĩ không?",
          "ru": "Артур — врач? (обращаясь к нему: «Вы врач?»)"
        }
      ]
    },
